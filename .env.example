# BioLink Premium — Environment Variables Template
# Copy values into the Replit Secrets panel (Tools → Secrets), NOT in this file.
# This file is safe to commit — it contains no real values.

PORT=5000
HOST=0.0.0.0

# JWT signing key (generate a long random string)
JWT_SECRET=

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your app domain
OAUTH_CALLBACK=https://your-app.replit.app

# GitHub token for pushing code (optional, for CI)
GITHUB_PERSONAL_ACCESS_TOKEN=
